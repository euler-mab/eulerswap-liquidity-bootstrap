# Mainnet RPC (Alchemy/Infura/etc.) — used for fork tests and broadcasts.
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key

# Deployer key. MUST hold SEED_USDC of USDC and SEED_USDT of USDT before broadcast.
# This address becomes the LP / eulerAccount that owns the position.
PRIVATE_KEY=0x...

# Optional, for `forge verify` / etherscan.
ETHERSCAN_API_KEY=
